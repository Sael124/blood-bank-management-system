# Copy this file to ".env" and adjust the values to your machine.
# Never commit the real ".env" file - it may contain a database password.

# --- SQL Server connection ---
BECS_DB_SERVER=localhost\SQLEXPRESS
BECS_DB_NAME=BloodBank
BECS_DB_DRIVER=ODBC Driver 18 for SQL Server

# Leave both empty to use Windows Authentication (recommended, no password stored).
# Fill them only when connecting with a SQL Server login.
BECS_DB_USER=
BECS_DB_PASSWORD=

# Local SQL Server Express usually has no trusted TLS certificate.
BECS_DB_ENCRYPT=no
BECS_DB_TRUST_CERTIFICATE=yes

# --- Web application ---
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BECS_SECRET_KEY=

BECS_HOST=127.0.0.1
BECS_PORT=5000
BECS_DEBUG=false

# Demo sign-in accounts (admin / operator / researcher) are created on the first
# run when the users table is empty. Their passwords are shown on the login
# screen for academic marking and are not stored here.
